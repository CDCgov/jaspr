# Start from Miniforge base (Minimal Ubuntu) to avoid Debian tar CVE lineage.
FROM quay.io/condaforge/miniforge3:latest

# System packages we need in the single container
RUN apt-get -y update && \
    apt-get -y upgrade && \
    apt-get -y install --no-install-recommends nginx supervisor curl libx11-6 && \
    rm -rf /var/lib/apt/lists/*

# --- App build (copy what dockerfile-jaspr already does) ---
COPY environment.yml .
RUN conda env create -f environment.yml
RUN . /opt/conda/etc/profile.d/conda.sh && conda activate jaspr_env && \
    conda install python=3.11 && \
    pip install --upgrade "async-timeout>=4.0.3" "flask-session>=0.8.0"

ADD requirements.txt .
ADD ./build /build
RUN . /opt/conda/etc/profile.d/conda.sh && conda activate jaspr_env && \
        conda install -c conda-forge --file requirements.txt && \
        pip install --upgrade \
            "pip>=26.0" \
            "setuptools>=78.1.1" \
            "wheel>=0.46.2" \
            "requests>=2.33.0" \
            "pygments>=2.20.0" \
            "urllib3>=2.6.3" \
            "pillow>=12.1.1" \
            "tornado>=6.5.5" \
            "cryptography>=46.0.5" \
            "jaraco.context>=6.1.0" \
            "Brotli>=1.2.0" && \
        conda clean -afy

# Also patch vulnerable Python tooling in the base conda environment.
RUN /opt/conda/bin/pip install --upgrade \
            "pip>=26.0" \
            "setuptools>=78.1.1" \
            "wheel>=0.46.2" \
            "requests>=2.33.0" \
            "pygments>=2.20.0" \
            "urllib3>=2.6.3" \
            "pillow>=12.1.1" \
            "tornado>=6.5.5" \
            "cryptography>=46.0.5" \
            "jaraco.context>=6.1.0" \
            "Brotli>=1.2.0"

# Bundle example datasets/assets for in-container download routes.
RUN mkdir -p /var/JASPR/example_data
COPY example_data/ /var/JASPR/example_data/

# App runtime location (matches existing image)
COPY app/ /app/
WORKDIR /app

# --- Nginx config + setup script (copied from your nginx image layout) ---
# These config paths are the ones used by your nginx Dockerfile today:
#   site.conf -> /etc/nginx/conf.d/site.conf
#   healthcheck.conf -> /etc/nginx/conf.d/healthcheck.conf
#   setup.sh -> /root/setup.sh
# (see nginx Dockerfile snippet) :contentReference[oaicite:2]{index=2}
COPY build/docker/nginx/site.conf /etc/nginx/conf.d/site.conf
COPY build/docker/nginx/healthcheck.conf /etc/nginx/conf.d/healthcheck.conf
COPY build/docker/nginx/setup.sh /root/setup.sh
RUN chmod 0700 /root/setup.sh

# Copy localhost cert inputs used by setup.sh (localhost.conf content exists) :contentReference[oaicite:3]{index=3}
COPY build/docker/nginx/localhost.conf /root/localhost.conf
RUN mkdir -p /etc/ssl && \
    openssl req -batch -x509 -nodes -days 30 -newkey rsa:2048 \
      -keyout /etc/ssl/localhost.key -out /etc/ssl/localhost.crt \
      -config /root/localhost.conf

RUN mkdir -p /var/log/uwsgi && \
    touch /var/log/uwsgi/uwsgi.log && \
    chmod 644 /var/log/uwsgi/uwsgi.log

# Supervisor config + entrypoint
COPY build/docker/single/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY build/docker/single/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 80 443
CMD ["/entrypoint.sh"]
