# syntax=docker/dockerfile:1.6
#
# JASPR single-container image, rebuilt for portability across
# Docker, Podman, and Singularity (Apptainer).
#
# Design constraints:
#   * Non-root runtime (UID/GID 1000, named "jaspr").
#   * Listens on a non-privileged port (8080) so it works under unprivileged
#     Singularity / rootless Podman without CAP_NET_BIND_SERVICE.
#   * No nginx, no supervisor, no embedded redis: a single uWSGI process
#     speaks HTTP directly.  TLS is expected to be terminated upstream
#     (host nginx, ingress, reverse-proxy, etc.) when needed.
#   * No dynamic install or bootstrap at launch.  The jaspr package is
#     pip-installed at build time; the entrypoint exec()s uWSGI directly.
#   * Writes only to /tmp at runtime.  /tmp is the one path that is
#     reliably writable under Singularity, rootless Podman, and Docker
#     without explicit volume configuration.
#   * Image filesystem is treated as read-only at runtime so the same
#     image runs unchanged under "singularity run" (read-only overlay)
#     and "podman run --read-only".
#
# ---------------------------------------------------------------------------
# Stage 1: install into a virtual environment. Compile uWSGI here so
# the runtime image contains no compiler or Python package installer.
# ---------------------------------------------------------------------------
FROM cgr.dev/chainguard/python:latest-dev@sha256:3bc6fcecef7578a7c3eb97fc53ba7259fa3fe11008493e80145910cb2e0d51b9 AS builder

USER root

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apk add --no-cache tini

COPY build/docker/backport-python.sh /tmp/backport-python.sh
RUN sh /tmp/backport-python.sh

# Upgrade build tooling first so wheel builds use patched setuptools/wheel.
RUN python -m venv /opt/venv && \
    /opt/venv/bin/python -m pip install --upgrade \
        "pip>=26.0" \
        "setuptools>=78.1.1" \
        "wheel>=0.46.2"

COPY build/docker/requirements-pip.txt /tmp/requirements-pip.txt
RUN /opt/venv/bin/python -m pip install -r /tmp/requirements-pip.txt

# Install the application without retaining the source tree at runtime.
COPY app/ /src/app/
RUN /opt/venv/bin/python -m pip install --no-deps /src/app && \
    /opt/venv/bin/python -m pip check && \
    /opt/venv/bin/python -m pip uninstall -y pip setuptools wheel

RUN addgroup -S -g 1000 jaspr && \
    adduser -S -D -u 1000 -G jaspr -h /home/jaspr -s /bin/false jaspr

# ---------------------------------------------------------------------------
# Stage 2: runtime image. Only runtime libraries, the installed application,
# and the application data.
# ---------------------------------------------------------------------------
FROM cgr.dev/chainguard/python:latest@sha256:872a42d369a6d9efba17ff4ccf4c0ec103b9e511e5f77793b0f558b933e40929

USER root

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    HOME=/tmp \
    JASPR_HTTP_PORT=8080 \
    FLASK_APP=jaspr \
    PATH=/opt/venv/bin:/usr/bin:/bin

# Create an unprivileged service account.  Singularity will normally run
# as the *invoking* user (host UID), but having a real entry in /etc/passwd
# helps Docker/Podman and avoids "I have no name!" prompts when the host
# UID happens to match 1000.
COPY --from=builder /etc/passwd /etc/passwd
COPY --from=builder /etc/group /etc/group
COPY --from=builder /home/jaspr /home/jaspr
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /usr/bin/tini /usr/bin/tini
COPY --from=builder /patched/lib/ /usr/lib/
RUN ["python", "-c", "from pathlib import Path\nfor path in Path('/usr/lib/python3.15/http/__pycache__').glob('client.cpython-315*.pyc'):\n    path.unlink()\nfor path in Path('/usr/share/python-wheels').glob('*.whl'):\n    path.unlink()"]

# Static application assets (uwsgi config + example data).
COPY app/app.ini       /app/app.ini
COPY example_data/     /var/JASPR/example_data/
COPY build/docker/verify-image.py /app/verify-image.py

# Make app/data world-readable so the image works regardless of which UID
# Singularity / rootless Podman ends up running as.
RUN ["python", "-c", "import os\nfor root in ('/app', '/var/JASPR', '/home/jaspr', '/opt/venv'):\n    for directory, subdirs, files in os.walk(root):\n        os.chmod(directory, os.stat(directory).st_mode | 0o555)\n        for name in files:\n            path = os.path.join(directory, name)\n            if not os.path.islink(path):\n                os.chmod(path, os.stat(path).st_mode | 0o444)"]
RUN ["python", "/app/verify-image.py"]

WORKDIR /app
USER 1000:1000
EXPOSE 8080

# Healthcheck honored by Docker/Podman (Singularity ignores it).
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD ["python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/ping', timeout=3).status==200 else 1)"]

# Verify security invariants, then exec tini for PID-1 signal handling.
ENTRYPOINT ["python", "/app/verify-image.py", "--launch"]
CMD []
