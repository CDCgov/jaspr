# syntax=docker/dockerfile:1.6
#
# JASPR single-container image, rebuilt for portability across
# Docker, Podman, and Singularity (Apptainer).
#
# Design constraints:
#   * Non-root runtime (UID/GID 1000, named "jaspr").
#   * Listens on a non-privileged port (8080) so it works under unprivileged
#     Singularity / rootless Podman without CAP_NET_BIND_SERVICE.
#   * No nginx, no supervisor, no embedded redis: a single uWSGI process
#     speaks HTTP directly.  TLS is expected to be terminated upstream
#     (host nginx, ingress, reverse-proxy, etc.) when needed.
#   * No dynamic install or bootstrap at launch.  The jaspr package is
#     pip-installed at build time; the entrypoint exec()s uWSGI directly.
#   * Writes only to /tmp at runtime.  /tmp is the one path that is
#     reliably writable under Singularity, rootless Podman, and Docker
#     without explicit volume configuration.
#   * Image filesystem is treated as read-only at runtime so the same
#     image runs unchanged under "singularity run" (read-only overlay)
#     and "podman run --read-only".
#
# ---------------------------------------------------------------------------
# Stage 1: build wheels.  Compile uWSGI (the only package without a
# pre-built manylinux wheel) here so the runtime image stays slim.
# ---------------------------------------------------------------------------
FROM python:3.11-slim-bookworm AS builder

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
        build-essential \
        libpcre3-dev \
        libssl-dev && \
    rm -rf /var/lib/apt/lists/*

# Upgrade build tooling first so wheel builds use patched setuptools/wheel.
RUN pip install --upgrade \
        "pip>=26.0" \
        "setuptools>=78.1.1" \
        "wheel>=0.46.2"

COPY build/docker/requirements-pip.txt /tmp/requirements-pip.txt
RUN pip wheel --wheel-dir=/wheels -r /tmp/requirements-pip.txt

# Build a wheel for the jaspr package itself so the runtime image does not
# need a compiler or the source tree on PYTHONPATH.
COPY app/ /src/app/
RUN pip wheel --wheel-dir=/wheels --no-deps /src/app

# ---------------------------------------------------------------------------
# Stage 2: runtime image.  Only runtime libraries, the wheels we built,
# and the application data.
# ---------------------------------------------------------------------------
FROM python:3.11-slim-bookworm

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    HOME=/tmp \
    JASPR_HTTP_PORT=8080 \
    FLASK_APP=jaspr

# Runtime libraries:
#   libpcre3   - required by the uWSGI binary for routing/internal regex
#   libexpat1  - common transitive dep for openpyxl/xml-handling code
#   tini       - small init providing PID-1 signal handling
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
        libpcre3 \
        libexpat1 \
        tini && \
    rm -rf /var/lib/apt/lists/*

# Create an unprivileged service account.  Singularity will normally run
# as the *invoking* user (host UID), but having a real entry in /etc/passwd
# helps Docker/Podman and avoids "I have no name!" prompts when the host
# UID happens to match 1000.
RUN groupadd --system --gid 1000 jaspr && \
    useradd  --system --uid 1000 --gid 1000 \
             --home-dir /home/jaspr --create-home --shell /bin/false jaspr

# Install pre-built wheels.  Re-pin pip/setuptools/wheel in the runtime
# stage to satisfy CVE-driven lower-bound requirements.
COPY --from=builder /wheels /wheels
RUN pip install --upgrade \
        "pip>=26.0" \
        "setuptools>=78.1.1" \
        "wheel>=0.46.2" && \
    pip install --no-index --find-links=/wheels /wheels/*.whl && \
    rm -rf /wheels

# Static application assets (uwsgi config + example data).
COPY app/app.ini       /app/app.ini
COPY example_data/     /var/JASPR/example_data/

# Make app/data world-readable so the image works regardless of which UID
# Singularity / rootless Podman ends up running as.
RUN chmod -R a+rX /app /var/JASPR /home/jaspr

WORKDIR /app
USER 1000:1000
EXPOSE 8080

# Healthcheck honored by Docker/Podman (Singularity ignores it).
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/ping', timeout=3).status==200 else 1)" || exit 1

# tini provides PID-1 signal handling identical across Docker/Podman/Singularity.
ENTRYPOINT ["/usr/bin/tini", "--", "uwsgi", "--ini", "/app/app.ini"]
