# gather miniconda
FROM continuumio/miniconda3:latest

MAINTAINER CDCgov JASPR "ddidncirdflulimsdevelopers@cdc.gov"

#RUN apt-get --allow-releaseinfo-change update
RUN apt-get -y update && \
    apt-get -y upgrade && \
    apt-get -y install --no-install-recommends gconf-service libxext6 libxfixes3 libxi6 \
    libxrandr2 libxrender1 libcairo2 libcups2 libdbus-1-3 libexpat1 \
    libfontconfig1 libgcc1 libgconf-2-4 libgdk-pixbuf2.0-0 libglib2.0-0 \
    libgtk-3-0 libnspr4 libpango-1.0-0 libpangocairo-1.0-0 libstdc++6 \
    libx11-6 libx11-xcb1 libxcb1 libxcomposite1 libxcursor1 libxdamage1 \
    libxss1 libxtst6 libnss3 libasound2 libatk1.0-0 libc6 \
    ca-certificates fonts-liberation lsb-release xdg-utils wget && \
    apt-get -y purge --auto-remove tar && \
    rm -rf /var/lib/apt/lists/*

# libappindicator1 - removed from above Dec-2021, did not play nice with
#                    updated continuumio/miniconda3 container 

# update coda and install as much as possible of the jaspr packages
# to install to our new env, activate the env, then use pip3 to install
#RUN conda update -n base -c defaults conda

#RUN conda create -y --name jaspr -c conda-forge flask=2.0.1 blinker=1.4 \
#    bokeh=2.3.3 pandas=1.3.1 xlrd=2.0.1 xlsxwriter markdown=3.3.4 scipy=1.7.0 redis-py=5.0 \
#    phantomjs selenium=3.14.1 uwsgi=2.0.19.1 firefox geckodriver nodejs
COPY environment.yml .
RUN conda env create -f environment.yml
RUN . /opt/conda/etc/profile.d/conda.sh && conda activate jaspr_env && \
    conda install python=3.11 && \
    pip install --upgrade "async-timeout>=4.0.3" "flask-session>=0.8.0"

# flask-debugtoolbar - removed from above 3/29/2022, prevented app from building

# Copy the current directory contents into the container at /build
ADD requirements.txt .
ADD ./build /build
#WORKDIR /build

# create a new env, and install dependencies
# docker reccomends don't apt-get upgrade if you can avoid it
RUN . /opt/conda/etc/profile.d/conda.sh && conda activate jaspr_env && \
        conda install -c conda-forge --file requirements.txt && \
        pip install --upgrade \
            "pip>=26.0" \
            "setuptools>=78.1.1" \
            "wheel>=0.46.2" \
            "requests>=2.33.0" \
            "pygments>=2.20.0" \
            "urllib3>=2.6.3" \
            "pillow>=12.1.1" \
            "tornado>=6.5.5" \
            "cryptography>=46.0.5" \
            "jaraco.context>=6.1.0" \
            "Brotli>=1.2.0" && \
        conda clean -afy

# Also patch vulnerable Python tooling in the base conda environment.
RUN /opt/conda/bin/pip install --upgrade \
            "pip>=26.0" \
            "setuptools>=78.1.1" \
            "wheel>=0.46.2" \
            "requests>=2.33.0" \
            "pygments>=2.20.0" \
            "urllib3>=2.6.3" \
            "pillow>=12.1.1" \
            "tornado>=6.5.5" \
            "cryptography>=46.0.5" \
            "jaraco.context>=6.1.0" \
            "Brotli>=1.2.0"

VOLUME /app
WORKDIR /app

#CMD /bin/bash -i
#CMD /bin/bash -i -c "pip install -e . "; uwsgi --ini app.ini
CMD . /opt/conda/etc/profile.d/conda.sh && \
    conda activate jaspr_env && pip install -e . && \
    uwsgi --ini app.ini -H /opt/conda/envs/jaspr_env
