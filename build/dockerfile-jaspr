# gather miniconda
FROM continuumio/miniconda3
MAINTAINER Garrett Peterson "garrettp@yaharasoftware.com"

# Copy the current directory contents into the container at /build
ADD . /build
WORKDIR /build

# update conda, create a new env, and install dependencies
# docker reccomends don't apt-get upgrade if you can avoid it
RUN conda update -n base -c defaults conda
RUN conda create -y --name jaspr -c conda-forge --file requirements.txt

# to install to our new env, activate the env, then use pip3 to install
RUN . /opt/conda/etc/profile.d/conda.sh && conda activate jaspr && \
    pip install flask-session

VOLUME /app
WORKDIR /app

RUN apt-get -y update
RUN apt-get -y install gconf-service libxext6 libxfixes3 libxi6 \
    libxrandr2 libxrender1 libcairo2 libcups2 libdbus-1-3 libexpat1 \
    libfontconfig1 libgcc1 libgconf-2-4 libgdk-pixbuf2.0-0 libglib2.0-0 \
    libgtk-3-0 libnspr4 libpango-1.0-0 libpangocairo-1.0-0 libstdc++6 \
    libx11-6 libx11-xcb1 libxcb1 libxcomposite1 libxcursor1 libxdamage1 \
    libxss1 libxtst6 libappindicator1 libnss3 libasound2 libatk1.0-0 libc6\
    ca-certificates fonts-liberation lsb-release xdg-utils wget


#CMD /bin/bash -i
#CMD /bin/bash -i -c "pip install -e . "; uwsgi --ini app.ini
CMD . /opt/conda/etc/profile.d/conda.sh && \
    conda activate jaspr && pip install -e . && \
    conda install -y -c conda-forge firefox geckodriver &&\
    uwsgi --ini app.ini -H /opt/conda/envs/jaspr
